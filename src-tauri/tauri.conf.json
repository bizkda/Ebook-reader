{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ebook-reader",
  
  "identifier": "com.bizk.ebook-reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ebook-reader",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**", "$APPDATA/**", "$HOME/.local/share/com.bizk.ebook-reader/**"]
      }
    }
  },
 "bundle": {
  "active": true,
  "targets": ["deb", "rpm", "nsis", "msi", "app", "dmg"],
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ]
}}
